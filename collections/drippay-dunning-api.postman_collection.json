                {
                  "name": "Upsert the dunning schedule for this business",
                  "id": "0d947c79-0cc1-4568-a62a-029856f1bda1",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "PUT",
                    "header": [],
                    "url": {
                      "raw": "{{baseUrl}}/v1/dunning/schedule",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "v1",
                        "dunning",
                        "schedule"
                      ]
                    },
                    "description": "Create or replace the retry schedule. `retries` is an ordered list of steps, each with a `dayOffset` (days after `firstFailedAt`), a `retryPayment` flag, and an optional `emailTemplate` (`dunning_first_notice` | `dunning_second_notice` | `dunning_final_notice`). Steps must be strictly increasing by `dayOffset`. Set `isActive: false` to disable automatic retries without losing the schedule \u2014 manual retries via `POST /collections/{id}/retry` still work."
                  },
