{
  "opencollection": "1.0.0",
  "info": {
    "name": "Drip BillableMetrics Customer Portal API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Customer Portal",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get customer profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.drippay.dev/v1/portal/profile"
          },
          "docs": "Get customer profile"
        },
        {
          "info": {
            "name": "Update billing address",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.drippay.dev/v1/portal/profile/address"
          },
          "docs": "Update billing address"
        },
        {
          "info": {
            "name": "List subscriptions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.drippay.dev/v1/portal/subscriptions"
          },
          "docs": "List subscriptions"
        },
        {
          "info": {
            "name": "Cancel subscription",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.drippay.dev/v1/portal/subscriptions/:id/cancel",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Cancel subscription"
        }
      ]
    }
  ],
  "bundled": true
}