{
  "opencollection": "1.0.0",
  "info": {
    "name": "Drip BillableMetrics Workflows API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Workflows",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List workflows",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.drippay.dev/v1/workflows",
            "params": [
              {
                "name": "productSurface",
                "value": "",
                "type": "query"
              },
              {
                "name": "isActive",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List all workflows for your business."
        },
        {
          "info": {
            "name": "Create a workflow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.drippay.dev/v1/workflows",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new workflow definition for tracking agent runs."
        },
        {
          "info": {
            "name": "Get workflow",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.drippay.dev/v1/workflows/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a workflow by ID with usage statistics."
        },
        {
          "info": {
            "name": "Update workflow",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.drippay.dev/v1/workflows/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update workflow"
        }
      ]
    }
  ],
  "bundled": true
}